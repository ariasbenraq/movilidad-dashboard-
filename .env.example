NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=movilidad

REDIS_HOST=localhost
REDIS_PORT=6380

# At least 32 characters. Generate with: openssl rand -hex 32
INGEST_API_KEY=changeme

# At least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=changeme

# Origin of the frontend (CORS with credentials). Production: https://mov.hamstitors.trade
CORS_ORIGIN=http://localhost:5173

# true only behind Cloudflare/Caddy: trusts the CF-Connecting-IP header for the login rate limit
TRUST_PROXY=false
