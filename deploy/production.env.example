# Template for /opt/movilidad/.env on the server (chmod 600, owner: deploy).
# Never commit the real file. No quotes and no spaces: the same file feeds
# `docker run --env-file`, which does not strip them. Use hex or alphanumeric secrets.
NODE_ENV=production
PORT=3000

# Service names inside the stack's private network (see docker-stack.yml).
DB_HOST=postgres
DB_PORT=5432
DB_USER=movilidad
DB_PASSWORD=change_me
DB_NAME=movilidad

REDIS_HOST=redis
REDIS_PORT=6379

# At least 32 characters each. Generate with: openssl rand -hex 32
INGEST_API_KEY=changeme
JWT_SECRET=changeme

CORS_ORIGIN=https://movilidades.hamstitors.trade
# Behind Cloudflare + Caddy: trust CF-Connecting-IP for the login rate limit.
TRUST_PROXY=true

# OpenRouteService key. Optional: without it route fields stay null.
ORS_API_KEY=
